# 의존성 / 빌드 산출물
node_modules/
dist/
dist-ssr/
*.local

# Electron 패키징 산출물 (포터블 exe 등 대용량)
release/
dist-portable/
build-out/

# references — 예시·기밀 데이터 파일 제외 (소스코드/문서만 공개)
#   ⚠ 실제 고객 자료, 예시 xlsx/pptx, 임시 파일, 내부 작업 문서는 커밋 금지.
#   README.md / flowchart_generator.py (데이터 포맷 문서·프로토타입) 만 유지.
references/*.xlsx
references/*.xls
references/*.pptx
references/*.ppt
references/_tmp_b64.txt
references/unpacked/
references/files/
references/CLAUDE_CODE_PROMPT.md

# 내부 작업 문서 (빌드 프롬프트·구버전 스펙) — 공개 불필요
PATCH_PPT_xml_spec.md

# IDE / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / TS 캐시
.vite/
*.tsbuildinfo

# 환경 변수
.env
.env.*
!.env.example

# ────────────────────────────────────────────────────────────
# 감사 데이터 보호 — 실제 고객사 자료가 절대 커밋되지 않도록
# 샘플/익명화된 더미 데이터만 references/ 아래에 두고
# 실제 고객 파일은 아래 패턴에 맞춰 보관할 것.
# ────────────────────────────────────────────────────────────
*_실제_*
*_real_*
*_REAL_*
*_고객_*
*_client_*
*_CLIENT_*
secrets/
private/
clients/
